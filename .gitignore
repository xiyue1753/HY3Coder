# Secrets & local config (never commit)
.env
.env.local
*.secret
# 登录脚本与 cookie 数据（含凭证处理，不入 git）
scripts/cf_login.py
scripts/cf_cookie_test.py

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Runtime outputs：正式交付的结果（eval / refine / 探针 / 难度分）随仓库发布；
# 运行日志与历史分片不入库
data/outputs/_archived/
data/outputs/*.log
data/outputs/*.err
data/outputs/http_panel.*
data/outputs/serve_*
# 人工抽检以 data/audit/ 为权威版；outputs 下为副本与终审前初稿
data/outputs/audit_records*.jsonl
data/outputs/audit_rules.md

# 抓取/中间数据缓存（保留在项目内，但不入库）
data/cache/

# 抓题/入库中间产物（用例 json、抓题缓存、cookie 等，仅本地保留，不随公开仓库发布）
/data/cases/

# 一次性/历史脚本（抓题登录、一次性数据修正、demo 展示工作台；
# 仅本地保留以便复核，不随公开仓库发布。
# 例外：scripts/fix_extreme_mislabel.py —— 它记录交付题集的难度极端错标如何校正，
# 复核与复现都需要，随仓库发布，故不在下面的清单里）
scripts/ingest_abc.py
scripts/ingest_cf.py
scripts/ingest_cf_github.py
scripts/ingest_abc161d.py
scripts/batch_ingest_abc.py
scripts/batch_ingest_cf.py
scripts/cf_cookie_session.py
scripts/build_questions.py
scripts/fix_bad_cases.py
scripts/fix_question_format.py
scripts/rewrite_reference.py
scripts/verify_ref_rewrite.py
scripts/checkers/_apply_checkers.py
scripts/checkers/_batch_selftest.py
scripts/checkers/_selftest_checker.py
scripts/make_selfbuilt_report_html.py
scripts/make_audit_workbook.py
scripts/make_audit_review_md.py
scripts/make_exec_evidence.py

# 交互演示的运行期留档（题池/会话快照/判定记录）：现场生成，不进统计，不入库
data/questions/interactive.jsonl
data/outputs/interact_sessions.jsonl
data/outputs/eval_interactive.jsonl
data/outputs/refine_interactive.jsonl

# 演示录像：任务书要求的产出之一（HY3Coder-demo.mp4，79 秒），随仓库发布；
# 其余大体积媒体素材不入库
*.mov
*.mkv

# 临时展示/归档（一次性展示页与中间 json，不入库）
/archive/

# 展示类 HTML 报告（本地生成物，不入库）；
# 例外：REPORT.html 是分析报告正文的网页版，随报告一并交付
/reports/*.html
!/reports/REPORT.html

# 内部开发文档与留档数据（实现日志/抓取指南/真实模型输出留档，
# 不随公开仓库发布；文件保留本地工作区）
/docs/
/data/golden/

# 参赛任务书 PDF（内部评审材料，不入库）
*.pdf

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# 本地浏览器自动化调试产物（Playwright CLI）
/.playwright-cli/
/pick*.yml
*.tmp
