# Secrets & local config (never commit)
.env
.env.local
*.secret
# 登录脚本与 cookie 数据（含凭证处理，不入 git）
scripts/cf_login.py
scripts/cf_cookie_test.py
data/cases/cf_cookies*.json
data/cases/ref_originals.json
# 抓题中间缓存（题面 HTML 等，不入 git）
data/cases/_batch*_prompts/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Runtime outputs (regenerable)
data/outputs/*
!data/outputs/.gitkeep

# HF 数据集缓存（中间数据，保留在项目内但不入库）
data/cache/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
